# ============================================================================
# ForgeClosedML — root .env (on-prem docker compose + dashboard build)
# Copy to .env and fill in. Never commit real secrets.
# ============================================================================

# ── On-prem stack (used by docker-compose.yml) ───────────────────────────────
# LiteLLM master key protects the on-prem inference proxy.
LITELLM_MASTER_KEY=replace-with-strong-secret

# Shared API secret between the on-prem stack (diagnostic/tools) and the
# Cloudflare Worker. Prefer per-service short-lived credentials in production.
FORGE_API_SECRET=replace-with-worker-api-secret

# ── Dashboard (Vite build time) ──────────────────────────────────────────────
# Leave blank to use same-origin (recommended when dashboard and worker are
# served through the same Cloudflare Access zone). Set an explicit origin if
# the dashboard lives on a different hostname than the API.
VITE_API_BASE=
