{
  "name": "forge-closedml-worker",
  "version": "1.0.0-beta",
  "private": true,
  "description": "ForgeClosedML \u2014 Cloudflare Worker API Gateway for Closed ML Environment",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "db:create": "wrangler d1 create forge-closedml-db",
    "db:migrate": "wrangler d1 execute forge-closedml-db --file=./migrations/0001_initial.sql",
    "db:migrate:staging": "wrangler d1 execute forge-closedml-db-staging --file=./migrations/0001_initial.sql",
    "db:migrate:local": "wrangler d1 execute forge-closedml-db --file=./migrations/0001_initial.sql --local",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/**/*.test.ts",
    "test:auth": "node --test --experimental-strip-types test/auth.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "^5.7.0",
    "wrangler": "^3.95.0"
  }
}
